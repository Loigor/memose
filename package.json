{
  "name": "memose",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:ts": "node --test tests/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "npm run test:ts && npm run test:rust",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "node release/sync-version.mjs && npm run build && npm run test:ts && npm run lint:rust && npm run test:rust",
    "pretauri": "node release/sync-version.mjs",
    "tauri": "tauri",
    "release": "node release/build.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "dompurify": "^3.2.6",
    "marked": "^16.2.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
