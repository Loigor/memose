{
  "name": "memose",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test:ts": "node --test tests/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "npm run test:ts && npm run test:rust",
    "test:ui": "playwright test --grep-invert @scale",
    "test:ui:headed": "playwright test --headed",
    "demo:record": "playwright test -c playwright.demo.config.ts",
    "test:scale:ui": "playwright test --grep @scale",
    "test:scale:rust": "cargo test --manifest-path src-tauri/Cargo.toml scale_stress_ -- --include-ignored --nocapture",
    "test:scale": "npm run test:scale:ui && npm run test:scale:rust",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "node release/sync-version.mjs && npm run format:check && npm run lint && npm run build && npm run test:ts && npm run fmt:rust:check && npm run lint:rust && npm run test:rust",
    "pretauri": "node release/sync-version.mjs",
    "tauri": "tauri",
    "release": "node release/build.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "dompurify": "^3.2.6",
    "marked": "^16.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.16"
  }
}
